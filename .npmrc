# pnpm Configuration for Vercel Deployment Fix
# This file ensures maximum compatibility with existing dependencies
# while using pnpm as the package manager

# Use hoisted node_modules for compatibility with tools expecting flat structure
node-linker=hoisted

# Shamefully hoist all dependencies to root for maximum compatibility
# This helps with dependencies that don't properly declare their peer dependencies
shamefully-hoist=true

# Don't fail on peer dependency conflicts
# Some packages have overly strict peer dependency requirements
strict-peer-dependencies=false

# Auto-install peer dependencies
auto-install-peers=true
